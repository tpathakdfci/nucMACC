{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/uschwartz/nucMACC//nextflow_schema.json",
  "title": "uschwartz/nucMACC pipeline parameters",
  "description": "Nextflow differential MNase-seq analysis pipeline",
  "type": "object",
  "definitions": {
    "input_output_options": {
        "title": "Input/output options",
        "type": "object",
        "fa_icon": "fas fa-terminal",
        "description": "Define where the pipeline should find input data and save output data.",
        "required": ["csvInput", "analysis", "outDir", "genome_type"],
          "properties": {
                  "analysis": {
                    "type": "string",
                    "default": "nucMACC",
                    "enum": [
                        "nucMACC",
                        "MNaseQC"
                    ]
                },
                  "csvInput": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to comma-separated file containing information about the samples in the experiment.",
                    "help_text": "You will need to create a samplesheet with information about the samples in your experiment before running the pipeline. Use this parameter to specify its location. Look at the documentation here for more information [usage docs](https://github.com/uschwartz/nucMACC)"
                },
                    "outDir": {
                      "type": "string",
                      "format": "directory-path",
                      "description": "The output directory where the results will be saved.",
                      "fa_icon": "fas fa-folder-open"
                  },
                  "genome": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "mimetype": "text/plain",
                    "pattern": "^\\S+\\.fn?a(sta)?(\\.gz)?$",
                    "description": "Path to FASTA genome file.",
                    "help_text": "This parameter is *mandatory* if `--genome` is not specified. If you don't have the appropriate alignment index available this will be generated for you automatically. Combine with `--save_reference` to save alignment index for future runs.",
                    "fa_icon": "far fa-file-code"
                },
                "genomeIdx": {
                  "type": "string",
                  "format": "file-path",
                  "fa_icon": "fas fa-bezier-curve",
                  "description": "Path to tar.gz archive for pre-built Bowtie2 index."
              },
            "TSS": {
              "type": "string",
              "format": "file-path",
              "mimetype": "text/plain"

            },
            "blacklist": {
              "type": "string",
              "format": "file-path",
              "mimetype": "text/plain"
            },
            "genomeSize": {
              "type": "integer",
              "default": 5000000
            },
            "correlationMethod": {
              "type": "string",
              "default": "spearman"
            },
            "publishBam": {
              "type": "boolean"
            },
            "publishBamFlt": {
              "type": "boolean"
            },
            "bamEntry": {
              "type": "boolean"
            },
            "low_memory": {
              "type": "string",
              "default": "14 GB"
            },
            "high_memory": {
              "type": "string",
              "default": "45 GB"
            },
            "container_engine": {
              "type": "string",
              "default": "docker"
            }  
          }
     }
 }
}